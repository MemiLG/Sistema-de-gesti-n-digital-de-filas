<?xml version="1.0" encoding="UTF-8"?>
<!--
    POM del proyecto: SistemaGFMonitor
    Ruta: SistemaGFMonitor/pom.xml

    Contiene los paquetes:
      - monitor
      - seguridad
      - factorySeguridad

    Punto de entrada: monitor.MainMonitor (nuevo main)

    REQUISITO PREVIO:
      Antes de compilar este proyecto hay que instalar SistemaGFServidor
      en el repositorio local Maven:
          cd ../SistemaGFServidor && mvn install

    Por qué Monitor depende de Servidor:
      - monitor.Monitor          → instancia new Servidor(...)   (salvarServidorCaido)
      - monitor.Monitor          → usa ColaIngreso y Historial   (paquete negocio)
      - monitor.Monitor          → usa ConstantesServidor        (paquete servidor)
      - monitor.Monitor          → instancia new InterfazServidor(...)  (paquete vistas)
      - monitor.Echo / Ping      → importan ConstantesServidor   (paquete servidor)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Si usás el POM padre, activá el bloque <parent>.
    -->
    <!--
    <parent>
        <groupId>grupo1</groupId>
        <artifactId>SistemaGF</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    -->

    <groupId>grupo1</groupId>
    <artifactId>SistemaGFMonitor</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <exec.mainClass>monitor.Monitor</exec.mainClass>
    </properties>

    <dependencies>

        <!--
            DEPENDENCIA CENTRAL: el proyecto Servidor.
            Monitor necesita clases de los paquetes:
              servidor  (Servidor, ConstantesServidor)
              negocio   (ColaIngreso, Historial)
              vistas    (InterfazServidor)
              absfactory / archivo / persistencia  (transitivas, ya incluidas)

            Para que Maven resuelva esta dependencia hay que haber ejecutado
            previamente:  cd ../SistemaGFServidor && mvn install
        -->
        <dependency>
            <groupId>grupo1</groupId>
            <artifactId>SistemaGFServidor</artifactId>
            <version>1.0-SNAPSHOT</version>
            <!--
                Se usa el JAR "normal" (sin shade), no el fat-jar,
                para evitar conflictos de clases duplicadas al hacer
                el shade de Monitor.
                Si el shade de Servidor produce el jar original en el
                repositorio local (gracias a shadedArtifactAttached=true),
                esta declaración sin <classifier> funcionará directamente.
            -->
        </dependency>

        <!-- Layouts de NetBeans (transitiva desde Servidor, declarada aquí por si acaso) -->
        <dependency>
            <groupId>org.netbeans.external</groupId>
            <artifactId>AbsoluteLayout</artifactId>
            <version>RELEASE290</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                maven-shade-plugin: genera el fat jar ejecutable de Monitor.
                Ejecutar:  mvn package  → produce SistemaGFMonitor-1.0-SNAPSHOT-shaded.jar
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>shaded</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>monitor.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
